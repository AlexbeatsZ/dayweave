{
  "name": "dayweave",
  "productName": "Dayweave",
  "version": "0.4.0",
  "private": true,
  "description": "时织 — 待办、时间记录与跨时区课程表",
  "license": "MIT",
  "author": "Dayweave contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexbeatsZ/dayweave.git"
  },
  "homepage": "https://github.com/AlexbeatsZ/dayweave#readme",
  "bugs": {
    "url": "https://github.com/AlexbeatsZ/dayweave/issues"
  },
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run build:electron && node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 5178 --strictPort",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/copy-preload.mjs && node scripts/build-fudan-capture.mjs",
    "build": "npm run check && vite build && npm run build:electron",
    "check": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:desktop": "npm run build && node scripts/smoke-desktop.mjs",
    "test:api": "npm run build && node scripts/smoke-api.mjs",
    "test:portable": "node scripts/smoke-portable.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "screenshots": "node scripts/capture.mjs",
    "ai": "node scripts/api.mjs",
    "api:docs": "tsx scripts/generate-api.ts",
    "android:sync": "npm run build && cap sync android",
    "dist:android": "npm run android:sync && node scripts/package-android.mjs",
    "dist:mac": "npm run build && node scripts/package-macos.mjs",
    "start": "electron .",
    "dist:win": "npm run build && node scripts/package-windows.mjs",
    "serve:api": "node dist-electron/electron/headless.js",
    "bundle:ai": "npm run api:docs && node scripts/bundle-ai.mjs",
    "test:headless": "node scripts/smoke-headless.mjs",
    "test:tray": "npm run build && node scripts/smoke-tray.mjs"
  },
  "build": {
    "appId": "org.dayweave.desktop",
    "productName": "Dayweave",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "THIRD_PARTY_LICENSES.txt"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signExecutable": false,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dayweave",
      "artifactName": "Dayweave-${version}-Windows-Setup.exe"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "artifactName": "Dayweave-${version}-macOS-${arch}.${ext}",
      "minimumSystemVersion": "13.0"
    },
    "portable": {
      "artifactName": "Dayweave-${version}-Windows-x64.exe"
    },
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ]
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "bonjour-service": "^1.4.4",
    "ical.js": "^2.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.59.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
