<?xml version="1.0" encoding="utf-8"?>
<!-- Same hierarchy as course_widget, stacked for a 2x2 cell: the countdown label sits below because H:MM:SS fills the width. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:padding="14dp" android:clipToOutline="true" android:background="@drawable/widget_background">
    <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="课程表" android:textSize="12sp" android:fontFamily="google-sans-text-medium" android:textColor="@color/widget_accent" android:maxLines="1"/>
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="打开时织" android:textSize="17sp" android:fontFamily="google-sans" android:textColor="@color/widget_ink" android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/widget_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="12sp" android:fontFamily="google-sans-text" android:fontFeatureSettings="tnum" android:textColor="@color/widget_muted" android:maxLines="1" android:visibility="gone"/>
    <TextView android:id="@+id/widget_location" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="点击打开课程表" android:textSize="12sp" android:fontFamily="google-sans-text" android:textColor="@color/widget_muted" android:maxLines="1" android:ellipsize="end"/>
    <LinearLayout android:id="@+id/widget_countdown_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="vertical" android:visibility="gone">
        <Chronometer android:id="@+id/widget_countdown" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="24sp" android:fontFamily="google-sans" android:fontFeatureSettings="tnum" android:includeFontPadding="false" android:textColor="@color/widget_accent"/>
        <TextView android:id="@+id/widget_countdown_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:fontFamily="google-sans-text-medium" android:textColor="@color/widget_accent"/>
    </LinearLayout>
    <TextView android:id="@+id/widget_zone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Asia/Shanghai" android:textSize="10sp" android:fontFamily="google-sans-text" android:textColor="@color/widget_faint" android:maxLines="1" android:visibility="gone"/>
</LinearLayout>
