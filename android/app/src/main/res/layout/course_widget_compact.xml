<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_background">
    <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="下一节课" android:textSize="10sp" android:textColor="#4264B2"/>
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="打开时织" android:textSize="16sp" android:textStyle="bold" android:textColor="#25364B" android:maxLines="2" android:ellipsize="end"/>
    <TextView android:id="@+id/widget_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="导入课程" android:textSize="11sp" android:textColor="#4264B2"/>
    <TextView android:id="@+id/widget_location" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="点击打开课程表" android:textSize="10sp" android:textColor="#536780" android:maxLines="1" android:ellipsize="end"/>
    <Chronometer android:id="@+id/widget_countdown" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textSize="11sp" android:textColor="#4264B2"/>
    <TextView android:id="@+id/widget_zone" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Asia/Shanghai" android:textSize="9sp" android:textColor="#687A94"/>
</LinearLayout>
