<?xml version="1.0" encoding="utf-8"?>
<!-- Pixel/Material You style: tinted surface, Google Sans when the system provides it, one display-size countdown. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:padding="16dp" android:clipToOutline="true" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_status" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="课程表" android:textSize="14sp" android:fontFamily="google-sans-text-medium" android:textColor="@color/widget_accent" android:maxLines="1"/>
        <TextView android:id="@+id/widget_zone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Asia/Shanghai" android:textSize="12sp" android:fontFamily="google-sans-text" android:textColor="@color/widget_faint" android:maxLines="1"/>
    </LinearLayout>
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="打开时织，导入课程" android:textSize="20sp" android:fontFamily="google-sans" android:textColor="@color/widget_ink" android:maxLines="1" android:ellipsize="end"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:orientation="horizontal">
        <TextView android:id="@+id/widget_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:fontFamily="google-sans-text" android:fontFeatureSettings="tnum" android:textColor="@color/widget_muted" android:maxLines="1" android:visibility="gone"/>
        <TextView android:id="@+id/widget_separator" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" · " android:textSize="13sp" android:fontFamily="google-sans-text" android:textColor="@color/widget_faint" android:visibility="gone"/>
        <TextView android:id="@+id/widget_location" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="点击打开课程表" android:textSize="13sp" android:fontFamily="google-sans-text" android:textColor="@color/widget_muted" android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_countdown_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal" android:baselineAligned="true" android:visibility="gone">
        <Chronometer android:id="@+id/widget_countdown" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="32sp" android:fontFamily="google-sans" android:fontFeatureSettings="tnum" android:includeFontPadding="false" android:textColor="@color/widget_accent"/>
        <TextView android:id="@+id/widget_countdown_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textSize="14sp" android:fontFamily="google-sans-text-medium" android:textColor="@color/widget_accent"/>
    </LinearLayout>
    <TextView android:id="@+id/widget_secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:background="@drawable/widget_chip" android:textSize="12sp" android:fontFamily="google-sans-text-medium" android:fontFeatureSettings="tnum" android:textColor="@color/widget_on_container" android:maxLines="1" android:ellipsize="end" android:visibility="gone"/>
</LinearLayout>
