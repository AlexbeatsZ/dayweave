{
  "openapi": "3.0.3",
  "info": {
    "title": "Open Timelog local API",
    "version": "0.2.0",
    "description": "Desktop only. Start the app and read its local api.json discovery file. API listens on 127.0.0.1; requires Bearer authentication and rejects browser Origin headers. No arbitrary scripts, shell, filesystem access or destructive full-state restore."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:43127",
      "description": "Preferred port; use actual address from api.json if occupied."
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
