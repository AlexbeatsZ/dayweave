                    "type": "string",
                    "format": "date"
                  },
                  "spanIndex": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "direction": {
                    "type": "string",
                    "enum": ["up", "down"]
                  },
                  "expectedUpdatedAt": {
                    "type": "number",
                    "description": "Required for PATCH/DELETE: the exact updatedAt last read from the entity."
                  }
                },
                "required": ["date", "spanIndex", "direction", "expectedUpdatedAt"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success; JSON entity or list"
