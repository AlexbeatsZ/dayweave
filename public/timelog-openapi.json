        "parameters": [],
        "responses": {
          "200": {
            "description": "Success; JSON entity or list"
          },
          "400": {
            "description": "Invalid request or domain validation failure"
          },
          "401": {
            "description": "Missing or wrong token"
          },
          "403": {
            "description": "Browser Origin or non-loopback Host rejected"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Concurrent edit, timer mismatch or reused key"
          },
          "428": {
            "description": "Missing expectedUpdatedAt"
          },
          "503": {
            "description": "App unavailable. Query state before retrying writes."
