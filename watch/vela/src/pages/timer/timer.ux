<template>
  <div class="page">
    <div class="ring" style="border-color: {{ring}};"></div>
    <div if="{{timer}}" class="center">
      <text class="act" style="color: {{timer.color}};">{{timer.act}}</text>
      <text class="time">{{display}}</text>
      <text class="hint">{{hint}}</text>
      <div class="row">
        <input class="btn" type="button" value="{{timer.runningSince === null ? '继续' : '暂停'}}" onclick="toggle" />
        <input class="btn btn-stop" type="button" value="{{confirmStop ? '确认' : '结束'}}" onclick="stop" />
      </div>
      <input class="link" type="button" value="待办 {{taskCount}}" onclick="openTasks" />
    </div>
    <div else class="center">
      <text class="hint top">{{countdown ? countdown + ' 分钟倒计时' : '点活动开始计时'}}</text>
      <div class="grid">
        <input for="{{acts}}" class="chip" style="background-color: {{$item.c}};" type="button" value="{{$item.n}}" onclick="start($item.id)" />
      </div>
      <div class="row">
        <input for="{{presets}}" class="preset {{countdown === $item ? 'preset-on' : ''}}" type="button" value="{{$item}}′" onclick="pick($item)" />
      </div>
      <input class="link" type="button" value="待办 {{taskCount}}" onclick="openTasks" />
    </div>
    <text if="{{status}}" class="status">{{status}}</text>
  </div>
</template>

<script>
import router from '@system.router'
import vibrator from '@system.vibrator'
import { channel, clock } from '../../common/channel.js'

export default {
  private: {
    timer: null,
    acts: [],
    presets: [],
    taskCount: 0,
    countdown: 0,
    confirmStop: false,
    display: '00:00',
    hint: '',
    ring: '#2c2c2e',
    status: '连接手机…'
  },
  onInit() {
    channel.onView((view) => this.apply(view))
  },
  onShow() {
    this.refresh()
    this.tick = setInterval(() => this.render(), 1000)
  },
  onHide() {
    clearInterval(this.tick)
  },
  refresh() {
    channel.request('view').then((reply) => this.settle(reply))
  },
  settle(reply) {
    if (reply.ok) {
      this.status = reply.stale ? '离线数据' : ''
      return
    }
    this.status = reply.msg || '操作失败'
    // A conflict means another device changed the timer: show what is true now.
    if (reply.err === 'conflict' || reply.err === 'not_found') this.refresh()
  },
  apply(view) {
    this.timer = view.timer
    this.acts = view.acts || []
    this.presets = (view.presets || []).slice(0, 4)
    this.taskCount = (view.tasks || []).length
    this.confirmStop = false
    this.render()
  },
  render() {
    const t = this.timer
    if (!t) {
      this.ring = '#2c2c2e'
      return
    }
    const now = channel.now()
    const elapsed = t.spansMs + (t.runningSince === null ? 0 : now - t.runningSince)
    const counting = t.endAt && t.runningSince !== null
    this.display = clock(counting ? t.endAt - now : elapsed)
    this.hint = t.runningSince === null ? '已暂停' : counting ? '剩余' : '已计时'
    this.ring = t.runningSince === null ? '#8e8e93' : t.color
  },
  pick(minutes) {
    this.countdown = this.countdown === minutes ? 0 : minutes
  },
  start(activityId) {
    const fields = { activityId: activityId }
    if (this.countdown) fields.countdownMin = this.countdown
    this.status = '开始中…'
    channel.request('timer.start', fields).then((reply) => {
      if (reply.ok) vibrator.vibrate({ mode: 'short' })
      this.countdown = 0
      this.settle(reply)
    })
  },
  toggle() {
    const op = this.timer.runningSince === null ? 'timer.resume' : 'timer.pause'
    channel.request(op, { timerId: this.timer.id }).then((reply) => this.settle(reply))
  },
  stop() {
    if (!this.confirmStop) {
      this.confirmStop = true
      return
    }
    channel.request('timer.stop', { timerId: this.timer.id }).then((reply) => {
      if (reply.ok) vibrator.vibrate({ mode: 'long' })
      this.settle(reply)
    })
  },
  openTasks() {
    router.push({ uri: 'pages/tasks' })
  }
}
</script>

<style>
/* 466x466 round screen: content stays inside the inscribed square, about 330px wide. */
.page {
  width: 466px;
  height: 466px;
  background-color: #000000;
  justify-content: center;
  align-items: center;
}
.ring {
  position: absolute;
  left: 8px;
  top: 8px;
  width: 450px;
  height: 450px;
  border-radius: 225px;
  border-width: 6px;
}
.center {
  width: 340px;
  flex-direction: column;
  align-items: center;
}
.act {
  font-size: 30px;
  font-weight: bold;
}
.time {
  margin-top: 4px;
  font-size: 92px;
  font-weight: bold;
  color: #ffffff;
}
.hint {
  font-size: 22px;
  color: #8e8e93;
}
.top {
  margin-bottom: 12px;
}
.row {
  margin-top: 16px;
  flex-direction: row;
  justify-content: center;
}
.btn {
  width: 140px;
  height: 64px;
  margin: 0 8px;
  border-radius: 32px;
  background-color: #2c2c2e;
  font-size: 26px;
  color: #ffffff;
}
.btn-stop {
  background-color: #ff453a;
}
.grid {
  width: 340px;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: center;
}
.chip {
  width: 100px;
  height: 56px;
  margin: 5px;
  border-radius: 28px;
  font-size: 22px;
  color: #ffffff;
}
.preset {
  width: 70px;
  height: 46px;
  margin: 0 4px;
  border-radius: 23px;
  background-color: #2c2c2e;
  font-size: 20px;
  color: #ffffff;
}
.preset-on {
  background-color: #ffffff;
  color: #000000;
}
.link {
  margin-top: 14px;
  width: 160px;
  height: 44px;
  border-radius: 22px;
  background-color: #1c1c1e;
  font-size: 20px;
  color: #8e8e93;
}
.status {
  position: absolute;
  bottom: 40px;
  width: 466px;
  text-align: center;
  font-size: 20px;
  color: #ff9f0a;
}
</style>
