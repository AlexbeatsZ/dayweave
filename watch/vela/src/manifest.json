{
  "package": "org.dayweave.mobile",
  "name": "Dayweave",
  "versionName": "0.1.0",
  "versionCode": 1,
  "minPlatformVersion": 1200,
  "icon": "/common/logo.png",
  "deviceTypeList": ["watch"],
  "features": [
    { "name": "system.router" },
    { "name": "system.interconnect" },
    { "name": "system.vibrator" }
  ],
  "config": { "logLevel": "log", "designWidth": 466 },
  "router": {
    "entry": "pages/timer",
    "pages": {
      "pages/timer": { "component": "timer" },
      "pages/tasks": { "component": "tasks" }
    }
  }
}
